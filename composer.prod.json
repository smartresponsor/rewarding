{
  "name": "rewarding/reward",
  "description": "Rewarding platform component for non-monetary loyalty programs, points, tiers, earn/redeem rules, expiry, reversals, and benefits.",
  "type": "symfony-bundle",
  "license": "proprietary",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.4",
    "collectioning/collection": "dev-master",
    "cruding/crud": "dev-master",
    "failing/failure": "dev-master",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.6",
    "easycorp/easyadmin-bundle": "^5.5",
    "interfacing/interface": "dev-master",
    "objecting/object": "dev-master",
    "symfony/console": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/yaml": "^8.1",
    "tabling/table": "dev-master",
    "viewing/view": "dev-master"
  },
  "autoload": {
    "psr-4": {
      "App\\Rewarding\\": "src/"
    }
  },
  "extra": {
    "symfony": {
      "bundle": "App\\Rewarding\\RewardingBundle",
      "require": "^8.1"
    }
  },
  "config": {
    "sort-packages": true
  },
  "require-dev": {
    "gating/gate": "dev-master"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/smartresponsor/failing.git",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "https://github.com/smartresponsor/gating.git",
      "no-api": true
    }
  ]
}
